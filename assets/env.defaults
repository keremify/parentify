# Parentify demo configuration (checked in, no secrets)
#
# Loaded once at startup from assets/env.defaults. Edit a value, restart the
# app, and the change applies. This file is bundled into the app, so it must
# never hold a real secret.
#
# A --dart-define with the same name still wins at build time:
#   flutter run --dart-define=GEMINI_API_KEY=...
#
# Leave GEMINI_API_KEY unset to use the transparent on-device analysis.

# --- Gemini ---------------------------------------------------------------
# Supply the key with --dart-define or the in-app Settings sheet.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_OUTPUT_TOKENS=900

# Optional: replace the prompt asset with a single-line prompt.
# GEMINI_SYSTEM_PROMPT=

# --- Demo sign-in ---------------------------------------------------------
# These are sandbox values for the local SQLite backend, not real secrets.
DEMO_PARENT_EMAIL=parent@parentify.dev
DEMO_PARENT_PASSWORD=Parentify2026!
DEMO_CHILD_PIN=2026
